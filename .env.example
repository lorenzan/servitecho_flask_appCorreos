# =========================================================
# Variables de entorno para Tecuns Roofing (Servitecho)
# =========================================================
# Copia este archivo a .env y completa con tus valores reales.
# NO subas el archivo .env real a git (está en .gitignore).
# En PythonAnywhere NO se usa .env; configura las variables
# en el archivo WSGI o en la consola Bash (ver wsgi_pythonanywhere_example.py).
# =========================================================

# Clave secreta de Flask (genera una larga y aleatoria en producción)
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# En HTTPS (producción) pon 1 para cookies Secure
SESSION_COOKIE_SECURE=0

# URL base del sitio para sitemap.xml (ej. https://tudominio.com)
SITE_URL=

# =========================================================
# Google reCAPTCHA (para formulario de reseñas)
# =========================================================
# 1. Regístrate en: https://www.google.com/recaptcha/admin/create
# 2. Label: "Tecuns Roofing" (o tu nombre de sitio)
# 3. Tipo:
#    - v2: "Challenge (v2)" → "Checkbox 'No soy un robot'"
#    - v3: "Score-based (v3)" → Invisible
# 4. Dominios: agrega tu dominio (ej. tudominio.pythonanywhere.com)
#    y también 'localhost' y '127.0.0.1' para desarrollo local
# 5. Copia Site Key y Secret Key aquí:
RECAPTCHA_SITE_KEY=6Lcxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RECAPTCHA_SECRET_KEY=6Lcxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Versión: "v2" (checkbox) o "v3" (invisible, score-based)
RECAPTCHA_VERSION=v2

# Score mínimo para v3 (0.0 - 1.0). 0.5 es balance razonable.
# Solo aplica si RECAPTCHA_VERSION=v3
RECAPTCHA_MIN_SCORE=0.5

# =========================================================
# Filtro anti-spam (listas CSV, editables sin tocar código)
# =========================================================
# Palabras clave que marcan spam en el comentario
SPAM_KEYWORDS=bitcoin,crypto,mining,click here,viagra,casino,loan,debt,credit,earn money,make money,work from home

# Dominios de email temporales / spam bloqueados
SPAM_BLOCKED_DOMAINS=tempmail.com,10minutemail.com,guerrillamail.com,mailinator.com,trashmail.com,yopmail.com

# Acortadores de URL sospechosos
SPAM_URL_SHORTENERS=bit.ly,tinyurl.com,goo.gl,ow.ly,is.gd,buff.ly,adf.ly,shorte.st

# =========================================================
# Opcional: Configuración SMTP (también editable desde admin)
# =========================================================
# SMTP_EMAIL=tu-email@gmail.com
# SMTP_APP_PASSWORD=tu-contraseña-de-aplicacion
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SENDER_NAME=Tecuns Roofing
# NOTIFY_EMAIL=admin@tudominio.com